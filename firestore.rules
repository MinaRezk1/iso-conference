rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: Firebase Authentication (Email/Password) is blocked on this
    // project by the AI Studio "Starter tier" restriction, so admin login
    // is handled by the app itself via the "adminUsers" collection (see
    // src/lib/authUtils.ts) instead of real server-side auth. That means
    // these rules can no longer check request.auth — protection here
    // relies on the app's UI hiding admin controls from regular visitors,
    // not on the database rejecting unauthorized writes. Everything is
    // effectively open at the database level, same as any public app
    // without a real backend. Do not put sensitive data in this project.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
